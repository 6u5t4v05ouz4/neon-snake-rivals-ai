generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id            Int       @id @default(autoincrement())
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  cyanWins      Int       @default(0)
  magentaWins   Int       @default(0)
  totalMatches  Int       @default(0)
  matches       Match[]
}

model Match {
  id        Int      @id @default(autoincrement())
  winner    String?
  duration  Int      // Seconds
  createdAt DateTime @default(now())
  sessionId Int?
  session   Session? @relation(fields: [sessionId], references: [id])
}

model Bet {
  id            Int      @id @default(autoincrement())
  poolPda       String   // Solana pool PDA
  walletAddress String   // User's wallet public key
  side          String   // "cyan" or "magenta"
  amount        Float    // SOL amount
  txSignature   String   // Solana tx signature (proof)
  createdAt     DateTime @default(now())
  claimed       Boolean  @default(false)
  
  @@unique([poolPda, walletAddress]) // One bet per wallet per pool
  @@index([poolPda])
  @@index([walletAddress])
}

model MakerBet {
  id        Int      @id @default(autoincrement())
  poolPda   String   // Which pool
  side      String   // "cyan" or "magenta"
  amount    Float    // SOL amount
  reason    String   // "rebalance" or other
  result    String?  // "win", "lose", or null if pending
  txSignature String?
  createdAt DateTime @default(now())
  
  @@index([poolPda])
}
